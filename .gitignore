# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# research captures — regenerate with the scripts in docs/research
/docs/research/raw/shots/
/docs/research/local/shots/
/docs/research/compare/
/docs/research/widths/
/docs/research/platform-shots/

# macOS
.DS_Store

# Regenerable review captures (node docs/research/shoot-tiles.mjs)
docs/research/tiles/

# Floor check harness output (node docs/research/scratch/floor-check.mjs)
docs/research/scratch/floor-shots/
